 <bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="Customer ordering" processRef="Process"/></bpmn:collaboration>
 <bpmn:process id="Process" isExecutable="false">
  <bpmn:laneSet id="Lanes"><bpmn:lane id="Lane0" name="Customer"><bpmn:flowNodeRef>visit</bpmn:flowNodeRef><bpmn:flowNodeRef>explore</bpmn:flowNodeRef><bpmn:flowNodeRef>help</bpmn:flowNodeRef><bpmn:flowNodeRef>tools</bpmn:flowNodeRef><bpmn:flowNodeRef>basket</bpmn:flowNodeRef><bpmn:flowNodeRef>items</bpmn:flowNodeRef><bpmn:flowNodeRef>details</bpmn:flowNodeRef><bpmn:flowNodeRef>receipt</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane1" name="Cookie Shop"><bpmn:flowNodeRef>validate</bpmn:flowNodeRef><bpmn:flowNodeRef>valid</bpmn:flowNodeRef><bpmn:flowNodeRef>save</bpmn:flowNodeRef><bpmn:flowNodeRef>saved</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
  <bpmn:startEvent id="visit" name="Visit shop"/>
  <bpmn:userTask id="explore" name="Explore catalogue"/>
  <bpmn:exclusiveGateway id="help" name="Need help?"/>
  <bpmn:userTask id="tools" name="Find, compare or build"/>
  <bpmn:userTask id="basket" name="Review basket"/>
  <bpmn:exclusiveGateway id="items" name="Basket has items?"/>
  <bpmn:userTask id="details" name="Review and confirm details"/>
  <bpmn:serviceTask id="validate" name="Validate and price"/>
  <bpmn:exclusiveGateway id="valid" name="Input valid?"/>
  <bpmn:serviceTask id="save" name="Save or reuse request"/>
  <bpmn:exclusiveGateway id="saved" name="Save confirmed?"/>
  <bpmn:userTask id="receipt" name="Read confirmation"/>
  <bpmn:endEvent id="end" name="Finish"/>
  <bpmn:sequenceFlow id="Flow0" sourceRef="visit" targetRef="explore"/>
  <bpmn:sequenceFlow id="Flow1" sourceRef="explore" targetRef="help"/>
  <bpmn:sequenceFlow id="Flow2" sourceRef="help" targetRef="tools" name="Yes"/>
  <bpmn:sequenceFlow id="Flow3" sourceRef="help" targetRef="basket" name="No"/>
  <bpmn:sequenceFlow id="Flow4" sourceRef="tools" targetRef="basket"/>
  <bpmn:sequenceFlow id="Flow5" sourceRef="basket" targetRef="items"/>
  <bpmn:sequenceFlow id="Flow6" sourceRef="items" targetRef="details" name="Yes"/>
  <bpmn:sequenceFlow id="Flow7" sourceRef="items" targetRef="basket" name="Empty"/>
  <bpmn:sequenceFlow id="Flow8" sourceRef="details" targetRef="validate"/>
  <bpmn:sequenceFlow id="Flow9" sourceRef="validate" targetRef="valid"/>
  <bpmn:sequenceFlow id="Flow10" sourceRef="valid" targetRef="save" name="Yes"/>
  <bpmn:sequenceFlow id="Flow11" sourceRef="valid" targetRef="details" name="Correct details"/>
  <bpmn:sequenceFlow id="Flow12" sourceRef="save" targetRef="saved"/>
  <bpmn:sequenceFlow id="Flow13" sourceRef="saved" targetRef="receipt" name="Yes"/>
  <bpmn:sequenceFlow id="Flow14" sourceRef="saved" targetRef="details" name="Retry or edit"/>
  <bpmn:sequenceFlow id="Flow15" sourceRef="receipt" targetRef="end"/>
 </bpmn:process>

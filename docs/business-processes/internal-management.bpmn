 <bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="Internal order management and analytics" processRef="Process"/></bpmn:collaboration>
 <bpmn:process id="Process" isExecutable="false">
  <bpmn:laneSet id="Lanes"><bpmn:lane id="Lane0" name="Cookie Shop"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>validate</bpmn:flowNodeRef><bpmn:flowNodeRef>valid</bpmn:flowNodeRef><bpmn:flowNodeRef>failure</bpmn:flowNodeRef><bpmn:flowNodeRef>save</bpmn:flowNodeRef><bpmn:flowNodeRef>aggregate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane1" name="Editor"><bpmn:flowNodeRef>read</bpmn:flowNodeRef><bpmn:flowNodeRef>manage</bpmn:flowNodeRef><bpmn:flowNodeRef>filter</bpmn:flowNodeRef><bpmn:flowNodeRef>view</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
  <bpmn:startEvent id="start" name="Receive request"/>
  <bpmn:serviceTask id="validate" name="Validate and price"/>
  <bpmn:exclusiveGateway id="valid" name="Valid request?"/>
  <bpmn:endEvent id="failure" name="Reject request"/>
  <bpmn:serviceTask id="save" name="Save or reuse order"/>
  <bpmn:userTask id="read" name="Open Payload order"/>
  <bpmn:userTask id="manage" name="Review or update status"/>
  <bpmn:userTask id="filter" name="Choose reporting filters"/>
  <bpmn:serviceTask id="aggregate" name="Aggregate authorised data"/>
  <bpmn:userTask id="view" name="Inspect or export totals"/>
  <bpmn:endEvent id="end" name="Finish"/>
  <bpmn:sequenceFlow id="Flow0" sourceRef="start" targetRef="validate"/>
  <bpmn:sequenceFlow id="Flow1" sourceRef="validate" targetRef="valid"/>
  <bpmn:sequenceFlow id="Flow2" sourceRef="valid" targetRef="failure" name="No"/>
  <bpmn:sequenceFlow id="Flow3" sourceRef="valid" targetRef="save" name="Yes"/>
  <bpmn:sequenceFlow id="Flow4" sourceRef="save" targetRef="read"/>
  <bpmn:sequenceFlow id="Flow5" sourceRef="read" targetRef="manage"/>
  <bpmn:sequenceFlow id="Flow6" sourceRef="manage" targetRef="filter"/>
  <bpmn:sequenceFlow id="Flow7" sourceRef="filter" targetRef="aggregate"/>
  <bpmn:sequenceFlow id="Flow8" sourceRef="aggregate" targetRef="view"/>
  <bpmn:sequenceFlow id="Flow9" sourceRef="view" targetRef="end"/>
 </bpmn:process>
